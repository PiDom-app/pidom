# Copy to .env.local and fill in. Vite inlines VITE_* into the renderer bundle at
# build time; GOOGLE_* are loaded into the MAIN process only (see
# vite.main.config.ts `envPrefix`) and never reach the renderer.
#
# None of these are secrets in the confidential sense. A Convex deployment URL
# and OAuth client IDs are public identifiers, readable from any shipped binary.
# The desktop OAuth "client secret" Google issues for an installed app is
# explicitly non-confidential; it is kept in the main process purely so it never
# rides along in a web context, not because it protects anything on its own —
# PKCE is what secures the exchange.

# ─── Renderer (VITE_*, inlined into the web bundle) ──────────────────────────

# The shared Convex deployment, e.g. https://acme-cat-123.convex.cloud
VITE_CONVEX_URL=

# The Convex HTTP actions origin, e.g. https://acme-cat-123.convex.site
VITE_CONVEX_SITE_URL=

# ─── Main process (GOOGLE_*, never exposed to the renderer) ──────────────────

# The Google OAuth *Desktop app* client. Its client ID is the audience (`aud`)
# of the ID token this app obtains, so it must be registered as an
# `applicationID` in the shared convex/auth.config.ts or every token is rejected
# as wrong-audience.
GOOGLE_DESKTOP_CLIENT_ID=

# The non-confidential secret Google issues alongside a Desktop app client.
# Required by Google's token endpoint for installed-app clients even with PKCE.
GOOGLE_DESKTOP_CLIENT_SECRET=
