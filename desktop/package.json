{
  "name": "pidom-desktop",
  "productName": "Pidom",
  "version": "1.0.0",
  "description": "Pidom desktop companion — an Electron reader sharing the mobile app's Convex backend, theme, and security model.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/check-tokens.mjs",
    "quality": "npm run tokens && npm run typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-router-devtools": "^1.87.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "convex": "^1.45.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "electron-squirrel-startup": "^1.0.1",
    "fast-glob": "^3.3.2",
    "file-type": "^19.6.0",
    "lucide-react": "^1.39.0",
    "mime-types": "^2.1.35",
    "motion": "^11.15.0",
    "nanoid": "^5.0.9",
    "p-queue": "^8.0.1",
    "pdfjs-dist": "^4.9.155",
    "radix-ui": "^1.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.87.0",
    "@tanstack/router-plugin": "^1.87.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^44.0.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "keywords": [],
  "author": {
    "name": "Pidom"
  },
  "license": "MIT",
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.27.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.4": true
  }
}
