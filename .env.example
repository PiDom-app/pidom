# Copy to .env.local and fill in. Expo inlines EXPO_PUBLIC_* at build time, so
# restart the bundler with `npx expo start --clear` after any change here.
#
# None of these are secrets. A Convex deployment URL and OAuth client IDs are
# public identifiers, and anyone can read them out of a shipped binary. The
# Google *client secret* is deliberately absent: the native ID token flow never
# needs one, which is one less thing that can leak.

# Production app endpoint. Local `CONVEX_DEPLOYMENT` remains independent so
# `npx convex dev` cannot deploy to production by mistake.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# The WEB OAuth client ID — on Android and iOS both. It is the audience of the
# ID token, and it must be byte-identical to the GOOGLE_WEB_CLIENT_ID set on the
# Convex deployment or every token is rejected as wrong-audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The iOS OAuth client ID. Required for the iOS build; ignored on Android.
# Its reversed form also goes in app.config.ts under the google-signin plugin's
# iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Ask ──────────────────────────────────────────────────────────────────────
#
# Nothing goes here. Ask reaches its model through the Convex AI Gateway, which
# mints a short-lived deployment-scoped token inside the action — so there is no
# API key in this repository, none in `npx convex env`, and none on the handset.
#
# When a second provider is added, its key is set on the deployment
# (`npx convex env set OPENROUTER_API_KEY`) and read through the typed `env`
# object in `convex/model/agent.ts`. It must never become an `EXPO_PUBLIC_*`
# variable: that prefix is inlined into the bundle at build time, which is to
# say printed on the side of every APK.
